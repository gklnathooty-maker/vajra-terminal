# Phase 20 live-data controls.
# NEVER put actual secrets in this file or in the Android application.

# "authorized_vendor" keeps NSE/BSE as NotImplementedError stubs.
# "fyers" routes NSE through FyersProvider (see docs/fyers-setup.md).
MARKET_DATA_PROVIDER_MODE=authorized_vendor

NSE_LIVE_ENABLED=false
NSE_CREDENTIAL_REF=

BSE_LIVE_ENABLED=false
BSE_CREDENTIAL_REF=

# Only used when MARKET_DATA_PROVIDER_MODE=fyers. See docs/fyers-setup.md
# for how to obtain these (FYERS_ACCESS_TOKEN expires ~daily; minted via
# backend/scripts/fyers_login.py, not generated by this app itself).
FYERS_CLIENT_ID=
FYERS_ACCESS_TOKEN=

# The exact transport URL/authentication is intentionally provider-specific.
# Populate these only after receiving the licensed provider technical specification.
